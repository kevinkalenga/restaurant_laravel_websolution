    public function stripeSuccess(Request $request, OrderService $orderService)
    {
        $request->validate([
            'session_id' => ['required', 'string'],
        ]);

        try {
            $stripe = new StripeClient(
                config('gatewaySettings.stripe_secret_key')
            );

            $stripeSession = $stripe->checkout->sessions->retrieve(
                $request->session_id
            );

            if ($stripeSession->payment_status !== 'paid') {
                return redirect()->route('payment.cancel');
            }

            $orderId = $stripeSession->metadata->order_id ?? null;
            $paymentIntent = $stripeSession->payment_intent;

            if (!$orderId || !$paymentIntent) {
                \Log::warning('Stripe return missing order or payment intent.', [
                    'stripe_session_id' => $stripeSession->id,
                ]);

                return redirect()->route('payment.cancel');
            }

            $order = Order::where('id', $orderId)
                ->where('user_id', auth()->id())
                ->first();

            if (!$order) {
                \Log::warning('Stripe return order not found for current user.', [
                    'order_id' => $orderId,
                ]);

                return redirect()->route('payment.cancel');
            }

            $expectedAmount = (int) round((float) $order->grand_total * 100);
            $expectedCurrency = strtolower(
                (string) config('gatewaySettings.stripe_currency')
            );

            if (
                (int) $stripeSession->amount_total !== $expectedAmount ||
                strtolower((string) $stripeSession->currency) !== $expectedCurrency ||
                (string) $stripeSession->client_reference_id !== (string) $order->id
            ) {
                \Log::warning('Stripe payment details do not match order.', [
                    'order_id' => $order->id,
                    'stripe_session_id' => $stripeSession->id,
                ]);

                return redirect()->route('payment.cancel');
            }

            $wasJustPaid = false;

            \Illuminate\Support\Facades\DB::transaction(function () use (
                $order,
                $paymentIntent,
                $expectedCurrency,
                &$wasJustPaid
            ) {
                $lockedOrder = Order::whereKey($order->id)
                    ->lockForUpdate()
                    ->firstOrFail();

                // A repeat visit is safe only for the same transaction.
                if ($lockedOrder->payment_status === 'completed') {
                    if ($lockedOrder->transaction_id !== $paymentIntent) {
                        throw new \RuntimeException(
                            'Order already completed with a different transaction.'
                        );
                    }

                    return;
                }

                if (
                    $lockedOrder->payment_status !== 'pending' ||
                    $lockedOrder->order_status === 'cancelled'
                ) {
                    throw new \RuntimeException(
                        'Order is not eligible for payment confirmation.'
                    );
                }

                $lockedOrder->payment_method = 'Stripe';
                $lockedOrder->payment_status = 'completed';
                $lockedOrder->payment_approve_date = now();
                $lockedOrder->transaction_id = $paymentIntent;
                $lockedOrder->currency_name = $expectedCurrency;
                $lockedOrder->save();

                $wasJustPaid = true;
            });

            // Send notifications only once, after the payment update succeeds.
            if ($wasJustPaid) {
                OrderPlacedNotificationEvent::dispatch($order->id);

                $updatedOrder = Order::find($order->id);

                if ($updatedOrder) {
                    RTOrderPlacedNotificationEvent::dispatch($updatedOrder);
                }
            }

            $orderService->clearSession();

            return redirect()->route('payment.success');

        } catch (\Throwable $e) {
            \Log::error('Stripe payment confirmation failed.', [
                'message' => $e->getMessage(),
                'session_id' => $request->session_id,
            ]);

            return redirect()->route('payment.cancel');
        }
    }



    public function stripeCancel()
    {
        return redirect()->route('payment.cancel');
    }
