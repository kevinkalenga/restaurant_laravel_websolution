<?php

namespace App\Http\Controllers\Frontend;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Services\OrderService;
use Srmklive\PayPal\Services\PayPal as PayPalClient;
use App\Events\OrderPaymentUpdateEvent;
use App\Events\OrderPlacedNotificationEvent;
use App\Events\RTOrderPlacedNotificationEvent;
use Stripe\StripeClient;
use App\Models\Order;


class PaymentController extends Controller
{
    public function index()
    {
        if (
                count(session('cart', [])) === 0 ||
                !session()->has('delivery_fee') ||
                !session()->has('address')
            ) {
                return redirect()->route('checkout.index')
                    ->with('error', 'Please complete the checkout information first.');
        }
    
        $subTotal = cartTotal();
        $delivery = session()->get('delivery_fee', 0);
        $couponDiscount = session()->get('coupon.discount', 0);
        $ecfDiscount = session()->get('ecf_discount', 0);

        $discount = $couponDiscount + $ecfDiscount;

        $finalTotal = ($subTotal + $delivery) - $discount;
        // $discount = session()->get('coupon')['discount'] ?? 0;

        // $finalTotal = ($subTotal + $delivery) - $discount;

        return view('frontend.pages.payment', compact(
            'subTotal',
            'delivery',
            'discount',
            'finalTotal'
        ));
    }

    public function makePayment(Request $request, OrderService $orderService)
    {
       $request->validate([
         'payment_gateway' => ['required', 'string', 'in:paypal,stripe']
       ]);

       // Create Order   

       

       try {

           $order = $orderService->createOrder();

            // redirect user to the payment host
            if (!$order) {
                return response()->json([
                    'message' => 'Failed to create order.'
                ], 500);
            }
             
            switch ($request->payment_gateway) {

                case 'paypal':
                    return response()->json([
                        'redirect_url' => route('paypal.payment')
                    ]);
                case 'stripe':
                    return response()->json([
                        'redirect_url' => route('stripe.payment')
                    ]);

                default:
                    return response()->json([
                        'message' => 'Unsupported payment gateway.'
                    ], 400);
            }
         
          
       }catch(\Exception $e) {
          
          return response()->json([
            'message' => 'Payment could not be processed. Please try again.'
          ], 500);
       }

     
    }

    public function setPaypalConfig()
    {
        $settings = \App\Models\Setting::first();

        return [
            // 'mode' => $settings->paypal_mode,
            'mode' => config('gatewaySettings.paypal_account_mode'),

            'live' => [
                'client_id'     => config('gatewaySettings.paypal_api_key'),
                'client_secret' => config('gatewaySettings.paypal_secret_key'),
            ],

            'sandbox' => [
                'client_id'     => config('gatewaySettings.paypal_api_key'),
                'client_secret' => config('gatewaySettings.paypal_secret_key'),
            ],

            'payment_action' => 'Sale',
            'currency'       => config('gatewaySettings.paypal_currency'),
            'notify_url'     =>  url('/paypal/notify'),
            'locale'         => 'en_US',
            'validate_ssl'   => true,
        ];
    }
    
   
    public function payWithPaypal()
    {
        $orderId = session('order_id');

        $order = Order::where('id', $orderId)
            ->where('user_id', auth()->id())
            ->where('payment_status', 'pending')
            ->where('order_status', 'pending')
            ->first();

        if (!$order) {
            return redirect()->route('checkout.index')
                ->with('error', 'Aucune commande en attente valide. Veuillez reprendre le checkout.');
        }

        $currency = strtoupper(
            (string) config('gatewaySettings.paypal_currency')
        );

        $rate = (float) config('gatewaySettings.paypal_rate');

        $payableAmount = round((float) $order->grand_total * $rate, 2);

        if ($payableAmount <= 0 || $rate <= 0 || $currency === '') {
            return redirect()->route('payment.cancel')
                ->withErrors([
                    'error' => 'Le montant ou la devise PayPal est invalide.',
                ]);
        }

        try {
            $provider = new PayPalClient($this->setPaypalConfig());
            $provider->getAccessToken();

            $response = $provider->createOrder([
                'intent' => 'CAPTURE',
                'application_context' => [
                    'return_url' => route('paypal.success'),
                    'cancel_url' => route('paypal.cancel'),
                ],
                'purchase_units' => [
                    [
                        'custom_id' => (string) $order->id,
                        'invoice_id' => (string) $order->invoice_id,
                        'amount' => [
                            'currency_code' => $currency,
                            'value' => number_format(
                                $payableAmount,
                                2,
                                '.',
                                ''
                            ),
                        ],
                    ],
                ],
            ]);

            $approvalUrl = null;

            foreach (($response['links'] ?? []) as $link) {
                if (($link['rel'] ?? null) === 'approve') {
                    $approvalUrl = $link['href'] ?? null;
                    break;
                }
            }

            if (
                empty($response['id']) ||
                empty($approvalUrl) ||
                !filter_var($approvalUrl, FILTER_VALIDATE_URL)
            ) {
                \Log::warning('PayPal order creation returned an invalid response.', [
                    'order_id' => $order->id,
                ]);

                return redirect()->route('payment.cancel')
                    ->withErrors([
                        'error' => 'PayPal n’a pas pu préparer le paiement. Veuillez réessayer.',
                    ]);
            }

            // Associer le retour PayPal à cette commande et à cette session.
            session()->put('paypal_order_id', $response['id']);

            return redirect()->away($approvalUrl);

        } catch (\Throwable $e) {
            \Log::error('PayPal order creation failed.', [
                'order_id' => $order->id,
                'message' => $e->getMessage(),
            ]);

            return redirect()->route('payment.cancel')
                ->withErrors([
                    'error' => 'Impossible de démarrer le paiement PayPal. Veuillez réessayer.',
                ]);
        }
    }

        
        

   
    public function paypalSuccess(Request $request, OrderService $orderService)
    {
            $request->validate([
                'token' => ['required', 'string'],
            ]);

            $paypalOrderId = session('paypal_order_id');

            if (
                !is_string($paypalOrderId) ||
                $paypalOrderId === '' ||
                !hash_equals($paypalOrderId, (string) $request->token)
            ) {
                \Log::warning('PayPal return token does not match the session.');

                return redirect()->route('payment.cancel')
                    ->withErrors([
                        'error' => 'La session de paiement PayPal est invalide. Veuillez reprendre le checkout.',
                    ]);
            }
            
            
            
            
            
            
            try {
                $orderId = session('order_id');

                $order = Order::where('id', $orderId)
                    ->where('user_id', auth()->id())
                    ->first();

                if (!$order) {
                    return redirect()->route('payment.cancel')
                        ->withErrors([
                            'error' => 'Commande introuvable. Veuillez vérifier votre commande.',
                        ]);
                }

                // Une commande déjà payée ne doit pas déclencher de nouvelles notifications.
                if ($order->payment_status === 'completed') {
                    $orderService->clearSession();

                    return redirect()->route('payment.success');
                }

                if (
                    $order->payment_status !== 'pending' ||
                    $order->order_status !== 'pending'
                ) {
                    return redirect()->route('payment.cancel')
                        ->withErrors([
                            'error' => 'Cette commande ne peut pas être payée.',
                        ]);
                }

                $config = $this->setPaypalConfig();
                $provider = new PayPalClient($config);
                $provider->getAccessToken();

                $response = $provider->capturePaymentOrder($request->token);

                if (($response['status'] ?? null) !== 'COMPLETED') {
                    return redirect()->route('payment.cancel')
                        ->withErrors([
                            'error' => $response['error']['message']
                                ?? 'Le paiement PayPal n’a pas été confirmé.',
                        ]);
                }

                $purchaseUnit = $response['purchase_units'][0] ?? [];
                $customOrderId = $purchaseUnit['custom_id'] ?? null;
                $capture = $purchaseUnit['payments']['captures'][0] ?? null;

                if (
                    ($customOrderId !== null &&
                        (string) $customOrderId !== (string) $order->id) ||
                    !is_array($capture) ||
                    ($capture['status'] ?? null) !== 'COMPLETED' ||
                    empty($capture['id']) ||
                    !isset($capture['amount']['value'], $capture['amount']['currency_code'])
                ) {
                    \Log::warning('PayPal capture details are invalid.', [
                        'order_id' => $order->id,
                        'custom_id_present' => $customOrderId !== null,
                        'capture_present' => is_array($capture),
                    ]);

                    return redirect()->route('payment.cancel')
                        ->withErrors([
                            'error' => 'Les informations du paiement PayPal sont invalides.',
                        ]);
                }

                $expectedAmount = number_format(
                    round(
                        (float) $order->grand_total *
                        (float) config('gatewaySettings.paypal_rate'),
                        2
                    ),
                    2,
                    '.',
                    ''
                );

                $expectedCurrency = strtoupper(
                    (string) config('gatewaySettings.paypal_currency')
                );

                $capturedAmount = number_format(
                    (float) $capture['amount']['value'],
                    2,
                    '.',
                    ''
                );

                $capturedCurrency = strtoupper(
                    (string) $capture['amount']['currency_code']
                );

                if (
                    $capturedAmount !== $expectedAmount ||
                    $capturedCurrency !== $expectedCurrency
                ) {
                    \Log::warning('PayPal amount or currency does not match order.', [
                        'order_id' => $order->id,
                        'expected_amount' => $expectedAmount,
                        'captured_amount' => $capturedAmount,
                        'expected_currency' => $expectedCurrency,
                        'captured_currency' => $capturedCurrency,
                    ]);

                    return redirect()->route('payment.cancel')
                        ->withErrors([
                            'error' => 'Le montant ou la devise du paiement ne correspond pas à la commande.',
                        ]);
                }

                $wasJustPaid = false;

                \Illuminate\Support\Facades\DB::transaction(function () use (
                    $order,
                    $capture,
                    $capturedCurrency,
                    &$wasJustPaid
                ) {
                    $lockedOrder = Order::whereKey($order->id)
                        ->lockForUpdate()
                        ->firstOrFail();

                    if ($lockedOrder->payment_status === 'completed') {
                        // Ne pas modifier une commande déjà payée par une autre transaction.
                        if ($lockedOrder->transaction_id !== $capture['id']) {
                            throw new \RuntimeException(
                                'Order already completed with a different transaction.'
                            );
                        }

                        return;
                    }

                    if (
                        $lockedOrder->payment_status !== 'pending' ||
                        $lockedOrder->order_status !== 'pending'
                    ) {
                        throw new \RuntimeException(
                            'Order is not eligible for payment confirmation.'
                        );
                    }

                    $lockedOrder->payment_method = 'PayPal';
                    $lockedOrder->payment_status = 'completed';
                    $lockedOrder->payment_approve_date = now();
                    $lockedOrder->transaction_id = $capture['id'];
                    $lockedOrder->currency_name = $capturedCurrency;
                    $lockedOrder->save();

                    $wasJustPaid = true;
                });

                if ($wasJustPaid) {
                    OrderPlacedNotificationEvent::dispatch($order->id);

                    $updatedOrder = Order::find($order->id);

                    if ($updatedOrder) {
                        RTOrderPlacedNotificationEvent::dispatch($updatedOrder);
                    }
                }

                $orderService->clearSession();

                return redirect()->route('payment.success');

            } catch (\Throwable $e) {
                \Log::error('PayPal payment confirmation failed.', [
                    'message' => $e->getMessage(),
                ]);

                return redirect()->route('payment.cancel')
                    ->withErrors([
                        'error' => 'Impossible de confirmer le paiement PayPal. Vérifiez votre commande avant de réessayer.',
                    ]);
            }
    }

    
    
    
